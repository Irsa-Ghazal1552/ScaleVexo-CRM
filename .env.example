# Copy to .env and fill in. Never commit the real .env file.

# --- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://crm.example.com
APP_BASE_URL=http://localhost
# Secure cookies need HTTPS. Keep false for a plain http://localhost trial, true on a real domain.
DJANGO_SECURE_COOKIES=false
# CEO/owner and admins must set up an authenticator app when true
REQUIRE_MFA_FOR_PRIVILEGED=true

# --- Database (PostgreSQL)
DB_ENGINE=postgres
POSTGRES_DB=scalevexo
POSTGRES_USER=scalevexo
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432

# --- First workspace + owner (created once on first start)
WORKSPACE_NAME=ScaleVexo
WORKSPACE_TIMEZONE=Asia/Karachi
OWNER_EMAIL=ceo@scalevexo.com
OWNER_PASSWORD=change-me-strong-password
OWNER_FIRST_NAME=CEO
OWNER_LAST_NAME=

# Load fictional demo data (true only for trying the app)
SEED_DEMO=false

# --- AI (optional, CRM12). Leave empty to use the free offline test provider.
ANTHROPIC_API_KEY=

# --- Web server: ":80" for local trial, or your domain for automatic HTTPS
SITE_ADDRESS=:80

# --- Backups (infra/backup.sh)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
